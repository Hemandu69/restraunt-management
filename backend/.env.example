# Copy this file to .env and fill in real values. Never commit .env.

# Prisma datasource. SQLite file for local dev; point to a postgresql://
# connection string in production (and switch the provider in schema.prisma).
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:5173"

# JWT auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Cookie used to transport the JWT to the browser.
AUTH_COOKIE_NAME="rms_token"

# First-Manager provisioning (used only by `npm run seed:manager`).
# Not a public API - run locally/on the server, never expose over HTTP.
INITIAL_MANAGER_NAME="Restaurant Owner"
INITIAL_MANAGER_EMAIL="owner@example.com"
INITIAL_MANAGER_PASSWORD="ChangeMe123!"

# --- Supabase (server-side only) ---------------------------------------
# The secret/service key bypasses Row Level Security. It must only ever be
# read here, on the server. Never send it to the frontend, never log it,
# never commit a real value. Get both from Project Settings > API.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
