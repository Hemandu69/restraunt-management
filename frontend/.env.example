# Copy to .env.local for local development. Never commit real .env files.

# Base URL of the backend API.
VITE_API_URL=http://localhost:4000/api

# --- Supabase (public/publishable only) --------------------------------
# Safe for the browser: the anon/publishable key only ever grants what RLS
# policies allow. NEVER put SUPABASE_SECRET_KEY (or any service-role key)
# in this file or anywhere under frontend/ - that key bypasses RLS entirely.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
